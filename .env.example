#------------------- WSE -----------------------------------

WSE_LICENSE_KEY=YOUR_LICENSE_KEY_HERE
ADMIN_USER=admin
ADMIN_PASSWORD=wowza

# Set list of IP addresses that are authorized to use the REST API
IPWHITELIST=*
TRANSCODER=enabled
LOG_LEVEL=INFO
SIMU_LIVE=enabled

#------------------- WSE Manager -----------------------------------

MANAGER_LOG_LEVEL=WARN
WSE_HOST=http://wse.docker:8087

#------------------- MCP Server -----------------------------------

#use this for starting mcp server in http mode or stdio mode when profile is not used
#MCP_MODE=stdio  #or http
MCP_HOST=0.0.0.0
MCP_PORT=8002

# Authentication key for HTTP MCP requests
# REQUIRED FOR HTTP MODE: Must be set (not empty), clients must provide in X-Wowza-MCP-Key header
# NOT USED IN STDIO MODE (STDIO connections are trusted subprocesses)
# Generate a secure key: use a UUID or random string
MCP_KEY=YOUR_MCP_KEY_HERE

# Wowza Streaming Engine connection URL for MCP server
WOWZA_ENGINE_BASE_URL=http://wse.docker:8087
WOWZA_ENGINE_SERVER_NAME=Wowza Streaming Engine
WOWZA_ENGINE_VHOST_NAME=_defaultVHost_
WOWZA_ENGINE_INSTANCE_NAME=wowza
WOWZA_ENGINE_USERNAME=admin
WOWZA_ENGINE_PASSWORD=wowza

#------------------- Google ADK Client -----------------------------------

AGENT_PORT=3005
LLM_MODEL_CLOUD=openai/gpt-4o-mini
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Tool access flags - controls which Wowza tools are available
# Examples: "application", "publisher,monitoring", "all", "application,read"
WSE_FLAGS=application

# --- HTTP Mode Configuration ---
# Required for HTTP mode only
# Google ADK Client connects to MCP server via HTTP
WSE_MCP_URL=http://mcp.docker:8002/mcp
# Note: MCP_KEY (defined above) and WSE_FLAGS (defined above) are required for HTTP mode
# Agent passes WSE_FLAGS as X-Wowza-Flags header and MCP_KEY as X-Wowza-MCP-Key header

# --- STDIO Mode Configuration ---
# Required for STDIO mode only
# Google ADK Client spawns MCP server as subprocess
MCP_COMMAND=uv run /app/server.py
# Note: WSE_FLAGS (defined above) is required and passed to subprocess as WOWZA_FLAGS env var